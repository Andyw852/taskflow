    if sets:
        ps = (m.get("ps") or {}).get("dir")
        if not ps:
            print("错误：该材料还没有 project_setting，先跑 tf -p %s init。" % m["name"])
            return 1
        dst = os.path.join(ps, m.get("template_subdir") or "templates",
                           sname, STEP_CONF)
