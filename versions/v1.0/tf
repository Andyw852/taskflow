            old, _ = mod.set_value(dst, sec, key, val if val != "" else None)
            print("  [%s] %-18s %s -> %s" % (sec, key, old if old is not None
                                             else "（无）", val or "（删除）"))
    text, legend = build_step_conf(cfg, t, m, sname)
