+    scp = os.path.join(ps_dir, "templates", "step.conf")
+    if "bandgap_hse" not in seg:
+        bg = _stepconf_param_from_file(scp, "BANDGAP")
+        if bg is not None:
+            seg["bandgap_hse"] = (bg.lower() != "pbe")
